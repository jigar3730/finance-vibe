{
    "name": "Finance Data Science",
    "image": "mcr.microsoft.com/devcontainers/python:3.12",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "GrapeCity.gc-excelviewer",
                "mechatroner.rainbow-csv",
                "njpwerner.autodocstring",
                "KevinRose.vsc-python-indent",
                "ms-toolsai.jupyter",
            ]
        }
    },
    "postCreateCommand": "pip install --user uv==0.8.22 && ~/.local/bin/uv sync --frozen",
    "remoteUser": "vscode"
}
