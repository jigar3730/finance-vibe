# data/ is bind-mounted at runtime; never bake it into the image.
data/
.git/
.venv/
**/__pycache__/
*.pyc
.pytest_cache/
.env
# docs/: only the operating docs the dashboard serves (config.DOCS_PAGES).
docs/*
!docs/runbook.md
!docs/operations.md
!docs/coiled_cobra.md
!docs/breakout.md
!docs/UX_STANDARDS.md
